spike_main_subproject_deps = \
	fdt \
	fesvr \
	softfloat \
	disasm \
	riscv \

spike_main_install_prog_srcs = \
	spike.cc \
	contract-spike-diff.cc \
	spike-log-parser.cc \
	xspike.cc \
	termios-xspike.cc \

spike_main_srcs = \

spike_main_CFLAGS = -fPIC

# This hack adds all symbols from extension.o to spike's dynamic symbol
# table, which is required for dynamically loaded --extension libraries
spike_main_LDFLAGS = extension.o

libcontract_spike_atom.so : contract-spike-diff.o libspike_main.a libriscv.a libdisasm.a libsoftfloat.a libfesvr.a libfdt.a extension.o
	$(LINK) -shared -o $@ extension.o contract-spike-diff.o libspike_main.a libriscv.a libdisasm.a libsoftfloat.a libfesvr.a libfdt.a $(LIBS)
